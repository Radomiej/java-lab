# Umami: skopiuj wartości z Website settings → Tracking code.
VITE_UMAMI_SCRIPT_URL=https://stats.example.com/script.js
VITE_UMAMI_WEBSITE_ID=your-website-id

# Lokalnie zostaw zakomentowane. Na Vercel flaga włącza się sama po konfiguracji.
# VITE_ANALYTICS_ENABLED=true

# Backend tutora (nigdy VITE_OPENROUTER_API_KEY).
OPENROUTER_API_KEY=

# Sesje uczniów: hasła wyłącznie w zmiennych SERWERA, nigdy VITE_*.
VITE_TELEMETRY_ENABLED=false
TELEMETRY_ALLOWED_ORIGINS=http://127.0.0.1:5182,http://localhost:5182,https://java-lab-eta.vercel.app
TELEMETRY_TOKEN_SECRET=
RABBITMQ_HTTP_URL=https://mws03-52052.wykr.es
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
